{
  "name": "ayudasys-pixel-film",
  "private": true,
  "version": "1.0.0",
  "description": "A pixel short film (Remotion): smooth 3D street, pixel-art people",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Film out/ayudasys-may-tala-may-tiwala-1080p.mp4 --gl=angle --browser-executable=\"C:/Program Files/Google/Chrome/Application/chrome.exe\" --concurrency=3",
    "typecheck": "tsc --noEmit",
    "deliver": "node scripts/deliver.mjs",
    "audio": "node scripts/make-music.mjs && node scripts/make-sfx.mjs",
    "stills": "node scripts/stills.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.532",
    "@remotion/three": "4.0.532",
    "@types/three": "^0.171.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.532",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@types/react": "^19.0.0",
    "playwright": "^1.65.0",
    "typescript": "^5.6.0"
  }
}
