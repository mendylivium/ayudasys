# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=AyudaSys
APP_ENV=development          # development | production
APP_PORT=3000
APP_TIMEZONE=Asia/Manila

# ─── Database ─────────────────────────────────────────────────────────────────
# Choose one: sqlite | mysql | postgres
DB_DRIVER=sqlite
DB_FILE=./storage/database.db
DB_DEBUG=false               # log every SQL query

# MySQL / MariaDB
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=go_mvc

# PostgreSQL
# DB_DRIVER=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=go_mvc
# DB_SSLMODE=disable

# ─── Session (web) ────────────────────────────────────────────────────────────
SESSION_DRIVER=database      # database | memory
SESSION_LIFETIME=2h
SESSION_COOKIE=gomvc_session
# SESSION_SECURE_COOKIE=true # defaults to true in production (HTTPS only)

# ─── JWT (api) ────────────────────────────────────────────────────────────────
# Generate one with: go run . key:generate
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─── CORS (api) ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_DIST_PATH=./dist        # Vite build output, served as a folder
