<script setup>
import { Head, Link, router } from '@inertiajs/vue3'
import AppLayout from '@/Layouts/AppLayout.vue'
import { formatDate } from '@/lib/format'

const props = defineProps({
  item: { type: Object, required: true },
})

function destroy() {
  if (confirm('Delete this [[.Title]]?')) {
    router.delete(`/[[.Route]]/${props.item.id}`)
  }
}
</script>

<template>
  <AppLayout>
    <Head :title="item.name" />

    <div class="breadcrumbs mb-4 text-sm">
      <ul>
        <li><Link href="/[[.Route]]">[[.Plural]]</Link></li>
        <li>{{ item.name }}</li>
      </ul>
    </div>

    <div class="card border border-base-300 bg-base-100">
      <div class="card-body">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold">{{ item.name }}</h1>
            <p class="text-sm text-base-content/60">Created {{ formatDate(item.created_at) }}</p>
          </div>
          <div class="flex gap-2">
            <Link :href="`/[[.Route]]/${item.id}/edit`" class="btn btn-sm">Edit</Link>
            <button class="btn btn-error btn-outline btn-sm" @click="destroy">Delete</button>
          </div>
        </div>
      </div>
    </div>
  </AppLayout>
</template>
