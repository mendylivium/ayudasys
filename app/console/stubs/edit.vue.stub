<script setup>
import { Head, Link, useForm } from '@inertiajs/vue3'
import AppLayout from '@/Layouts/AppLayout.vue'
import FormField from '@/Components/FormField.vue'

const props = defineProps({
  item: { type: Object, required: true },
})

const form = useForm({
  name: props.item.name,
})
</script>

<template>
  <AppLayout>
    <Head :title="`Edit ${item.name}`" />

    <div class="card mx-auto max-w-2xl border border-base-300 bg-base-100">
      <form class="card-body" @submit.prevent="form.put(`/[[.Route]]/${item.id}`)">
        <h1 class="card-title text-2xl">Edit [[.Title]]</h1>

        <FormField v-slot="{ invalid }" label="Name" :error="form.errors.name">
          <input v-model="form.name" type="text" class="input w-full" :class="{ 'input-error': invalid }" autofocus />
        </FormField>

        <div class="card-actions justify-end pt-2">
          <Link :href="`/[[.Route]]/${item.id}`" class="btn btn-ghost">Cancel</Link>
          <button type="submit" class="btn btn-primary" :disabled="form.processing">Save</button>
        </div>
      </form>
    </div>
  </AppLayout>
</template>
