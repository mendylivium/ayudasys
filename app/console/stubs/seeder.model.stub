package seeders

import (
	"fmt"

	"gorm.io/gorm"

	"go-mvc/app/models"
)

// {{.Model}}Seeder — add it to DatabaseSeeder in database/seeders/seeder.go.
type {{.Model}}Seeder struct{}

func ({{.Model}}Seeder) Name() string { return "{{.Model}}Seeder" }

func ({{.Model}}Seeder) Run(db *gorm.DB) error {
	var count int64
	if err := db.Model(&models.{{.Model}}{}).Count(&count).Error; err != nil || count > 0 {
		return err
	}
	for i := 1; i <= 5; i++ {
		if err := db.Create(&models.{{.Model}}{Name: fmt.Sprintf("{{.Title}} #%d", i)}).Error; err != nil {
			return err
		}
	}
	return nil
}
